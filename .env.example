# --- Required ---
ILO_HOST=192.168.1.50
ILO_USERNAME=fanctrl

# --- Authentication: set ONE of these ---
ILO_PASSWORD=changeme
# ILO_SSH_KEY_PATH=/path/to/id_fanctrl
# ILO_SSH_KEY_PASSPHRASE=

# --- Optional (defaults shown) ---
ILO_PORT=22
ILO_CONNECT_TIMEOUT=15
# Delay between successive commands sent over the same session. iLO4's CLI
# is slow and can drop commands sent back-to-back.
ILO_COMMAND_DELAY=0.3
